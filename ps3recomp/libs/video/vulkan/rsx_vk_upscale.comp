#version 450
// Presentation upscaler (rsx_vulkan_backend.c, vk_present_window): the frame the engine drew at the
// guest's resolution is enlarged to the window with Catmull-Rom bicubic filtering (nine bilinear
// taps) and sharpened with a contrast-adaptive pass (the lobe shrinks where the neighbourhood is
// already contrasty, so edges do not ring). Not AMD FSR 1.0 -- same idea, our own code.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform Params {
    vec2 srcSize;
    vec2 dstSize;
    float sharp;       // 0 = none, 1 = strongest
} pc;

vec3 catmull(vec2 uv)
{
    vec2 pos = uv * pc.srcSize;
    vec2 c = floor(pos - 0.5) + 0.5;
    vec2 f = pos - c;
    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);
    vec2 w12 = w1 + w2;
    vec2 t0 = (c - 1.0) / pc.srcSize;
    vec2 t12 = (c + w2 / w12) / pc.srcSize;
    vec2 t3 = (c + 2.0) / pc.srcSize;
    vec3 r = textureLod(src, vec2(t0.x, t0.y), 0.0).rgb * (w0.x * w0.y)
           + textureLod(src, vec2(t12.x, t0.y), 0.0).rgb * (w12.x * w0.y)
           + textureLod(src, vec2(t3.x, t0.y), 0.0).rgb * (w3.x * w0.y)
           + textureLod(src, vec2(t0.x, t12.y), 0.0).rgb * (w0.x * w12.y)
           + textureLod(src, vec2(t12.x, t12.y), 0.0).rgb * (w12.x * w12.y)
           + textureLod(src, vec2(t3.x, t12.y), 0.0).rgb * (w3.x * w12.y)
           + textureLod(src, vec2(t0.x, t3.y), 0.0).rgb * (w0.x * w3.y)
           + textureLod(src, vec2(t12.x, t3.y), 0.0).rgb * (w12.x * w3.y)
           + textureLod(src, vec2(t3.x, t3.y), 0.0).rgb * (w3.x * w3.y);
    return max(r, vec3(0.0));
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.dstSize.x) || p.y >= int(pc.dstSize.y)) return;
    vec2 uv = (vec2(p) + 0.5) / pc.dstSize;
    vec2 px = 1.0 / pc.dstSize;
    vec3 e = catmull(uv);
    if (pc.sharp > 0.0) {
        vec3 b = catmull(uv + vec2(0.0, -px.y));
        vec3 d = catmull(uv + vec2(-px.x, 0.0));
        vec3 f = catmull(uv + vec2(px.x, 0.0));
        vec3 h = catmull(uv + vec2(0.0, px.y));
        vec3 mn = min(min(b, d), min(f, h));
        vec3 mx = max(max(b, d), max(f, h));
        mn = min(mn, e);
        mx = max(mx, e);
        vec3 amp = sqrt(clamp(min(mn, 1.0 - mx) / max(mx, vec3(1e-4)), 0.0, 1.0));
        vec3 w = amp * (-1.0 / mix(8.0, 5.0, pc.sharp));
        e = clamp((e + (b + d + f + h) * w) / (1.0 + 4.0 * w), 0.0, 1.0);
    }
    imageStore(dst, p, vec4(e, 1.0));
}
